# ==========================================
# বাংলার ফেস (BanglarFace) Environment Variables
# ==========================================

# 1. Supabase PostgreSQL & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-for-admin-operations

# 2. Cloudflare R2 Object Storage Credentials (S3-compatible)
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=banglarface-media
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# 3. Next.js Public App URL
NEXT_PUBLIC_SITE_URL=https://banglarface.vercel.app
